      ["ui_total_rejected"],
      ["ui_prod_rate"],
      ["ui_prod_target_disp"],
      ["ui_feed_state"],
      ["ui_feed_recv"],
      ["ui_feed_speed"],
      ["ui_feed_warn"],
      ["ui_asm_state"],
      ["ui_asm_proc"],
      ["ui_asm_cycle"],
      ["ui_asm_hcap"],
      ["ui_asm_hcnt"],
      ["ui_asm_warn"],
      ["ui_insp_state"],
      ["ui_insp_insp"],
      ["ui_insp_acc"],
      ["ui_insp_rej"],
      ["ui_insp_cycle"],
      ["ui_insp_hcap"],
      ["ui_insp_hcnt"],
