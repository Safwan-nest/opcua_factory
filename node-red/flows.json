    {
        "id": "fn_router",
        "type": "function",
        "z": "tab_factory",
        "name": "Unified Dashboard Router (19 Outputs)",
        "func": "const rev = flow.get(\"opcua_rev\") || {};\nconst cleanId = String(msg.topic || \"\").split(\";datatype=\")[0];\nconst key = rev[cleanId];\nif (!key) return null;\n\nconst val = (msg.payload && typeof msg.payload === \"object\" && \"value\" in msg.payload)\n    ? msg.payload.value\n    : msg.payload;\n\nconst out = new Array(19).fill(null);\n\nfunction stateBadge(s) {\n    const str = String(s || \"UNKNOWN\").toUpperCase();\n    let col = \"#9e9e9e\";\n    if (str === \"RUNNING\") col = \"#00c853\";\n    else if (str === \"FAULT\") col = \"#ff5252\";\n    else if (str === \"STOPPED\") col = \"#ffb300\";\n    return `<span style=\"color:${col};font-weight:bold;\">${str}</span>`;\n}\n\nfunction updateStationFault(stationName, stVal) {\n    const states = flow.get(\"station_states\") || {};\n    states[stationName] = String(stVal || \"\").toUpperCase();\n    flow.set(\"station_states\", states);\n    const faulted = Object.entries(states)\n        .filter(([, v]) => v === \"FAULT\")\n        .map(([k]) => k);\n    out[2] = {\n        payload: faulted.length\n            ? `<span style=\"color:#ff5252;font-weight:bold;\">${faulted.join(\", \")}</span>`\n            : \"None\"\n    };\n}\n\nswitch (key) {\n    case \"LineState\":\n        out[0] = { payload: stateBadge(val) };\n        break;\n    case \"AlarmActive\":\n        out[1] = {\n            payload: val\n                ? '<span style=\"color:#ff5252;font-weight:bold;\">ALARM ACTIVE</span>'\n                : '<span style=\"color:#00c853;font-weight:bold;\">NORMAL</span>'\n        };\n        break;\n    case \"FaultMessage\":\n        out[3] = { payload: val ? String(val) : \"None\" };\n        break;\n    case \"TotalProduced\":\n        out[4] = { payload: Number(val) };\n        break;\n    case \"TotalAccepted\":\n        out[5] = { payload: Number(val) };\n        break;\n    case \"TotalRejected\":\n        out[6] = { payload: Number(val) };\n        break;\n    case \"ProductionRate\":\n        out[7] = { payload: Number(Number(val).toFixed(2)) };\n        break;\n    case \"ProductionTarget\":\n        out[8] = { payload: Number(val) };\n        break;\n    case \"Feed_State\":\n        out[9] = { payload: stateBadge(val) };\n        updateStationFault(\"FeedingStation\", val);\n        break;\n    case \"Feed_Received\":\n        out[10] = { payload: Number(val) };\n        break;\n    case \"Feed_Speed\":\n        out[11] = { payload: `${Number(val).toFixed(2)} m/s` };\n        break;\n    case \"Asm_State\":\n        out[12] = { payload: stateBadge(val) };\n        updateStationFault(\"AssemblyStation\", val);\n        break;\n    case \"Asm_Processed\":\n        out[13] = { payload: Number(val) };\n        break;\n    case \"Asm_CycleTime\":\n        out[14] = { payload: `${Number(val).toFixed(2)} s` };\n        break;\n    case \"Insp_State\":\n        out[15] = { payload: stateBadge(val) };\n        updateStationFault(\"InspectionStation\", val);\n        break;\n    case \"Insp_Inspected\":\n        out[16] = { payload: Number(val) };\n        break;\n    case \"Insp_Accepted\":\n        out[17] = { payload: Number(val) };\n        break;\n    case \"Insp_Rejected\":\n        out[18] = { payload: Number(val) };\n        break;\n}\n\nreturn out;",
        "outputs": 19,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
