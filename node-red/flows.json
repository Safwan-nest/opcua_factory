  {
    "id": "fn_conn_state",
    "type": "function",
    "z": "tab_factory",
    "name": "Connection State Machine",
    "func": "const rawText = (msg.status && msg.status.text) ? String(msg.status.text).toLowerCase() : \"\";\nconst fill = (msg.status && msg.status.fill) ? String(msg.status.fill).toLowerCase() : \"\";\nconst prev = context.get(\"connState\") || \"INIT\";\nconst hadDisconnect = context.get(\"hadDisconnect\") || false;\nconst isUp = fill === \"green\" || rawText.includes(\"active\") || rawText.includes(\"subscribed\") || rawText.includes(\"keepalive\") || rawText.includes(\"session\");\nconst isDown = fill === \"red\" || rawText.includes(\"error\") || rawText.includes(\"closed\") || rawText.includes(\"disconnect\") || rawText.includes(\"reconnect\") || rawText.includes(\"terminated\") || rawText.includes(\"invalid\");\nlet nextState = prev, resubTrigger = null;\nif (isDown) { nextState = \"DISCONNECTED\"; context.set(\"hadDisconnect\", true); flow.set(\"opcua_connected\", false); }\nelse if (isUp) {\n    if (hadDisconnect) { nextState = \"RECONNECTED\"; context.set(\"hadDisconnect\", false); resubTrigger = { payload: \"resubscribe\" }; }\n    else if (prev === \"INIT\" || prev === \"DISCONNECTED\") nextState = \"CONNECTED\";\n    flow.set(\"opcua_connected\", true);\n}\nif (nextState === prev && !resubTrigger) return [null, null];\ncontext.set(\"connState\", nextState);\nconst col = { CONNECTED: \"#00c853\", RECONNECTED: \"#29b6f6\", DISCONNECTED: \"#ff5252\" }[nextState] || \"#aaa\";\nreturn [{ payload: `<span style=\"color:${col};font-weight:bold;\">${nextState}</span>` }, resubTrigger];",
    "outputs": 2,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 440,
    "y": 440,
    "wires": [["ui_conn_status"], ["dly_resub"]]
  },
