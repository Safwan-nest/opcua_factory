  {
    "id": "fn_router",
    "type": "function",
    "z": "tab_factory",
    "name": "Unified Dashboard Router (28 Outputs)",
    "func": "const rev = flow.get(\"opcua_rev\") || {};\nconst cleanId = String(msg.topic || \"\").split(\";datatype=\")[0];\nconst key = rev[cleanId];\nif (!key) return null;\nconst val = (msg.payload && typeof msg.payload === \"object\" && \"value\" in msg.payload) ? msg.payload.value : msg.payload;\nconst out = new Array(28).fill(null);\nfunction stateBadge(s) {\n    const str = String(s || \"UNKNOWN\").toUpperCase();\n    const col = str === \"RUNNING\" ? \"#00c853\" : str === \"FAULT\" ? \"#ff5252\" : str === \"IDLE\" ? \"#0288d1\" : \"#ffb300\";\n    return `<span style=\"color:${col};font-weight:bold;\">${str}</span>`;\n}\nfunction warnBadge(w) {\n    const s = w ? String(w) : \"None\";\n    return s === \"None\" ? '<span style=\"color:#757575;\">None</span>' : `<span style=\"color:#e65100;font-weight:bold;\">${s}</span>`;\n}\nfunction updFault(stName, stVal) {\n    const st = flow.get(\"station_states\") || {};\n    st[stName] = String(stVal || \"\").toUpperCase();\n    flow.set(\"station_states\", st);\n    const f = Object.entries(st).filter(([, v]) => v === \"FAULT\").map(([k]) => k);\n    out[2] = { payload: f.length ? `<span style=\"color:#ff5252;font-weight:bold;\">${f.join(\", \")}</span>` : \"None\" };\n}\nswitch (key) {\n    case \"LineState\": out[0] = { payload: stateBadge(val) }; break;\n    case \"AlarmActive\": out[1] = { payload: val ? '<span style=\"color:#ff5252;font-weight:bold;\">ALARM ACTIVE</span>' : '<span style=\"color:#00c853;font-weight:bold;\">NORMAL</span>' }; break;\n    case \"FaultMessage\": out[3] = { payload: val ? String(val) : \"None\" }; break;\n    case \"WarningMessage\": out[4] = { payload: warnBadge(val) }; break;\n    case \"TotalProduced\": out[5] = { payload: Number(val) }; break;\n    case \"TotalAccepted\": out[6] = { payload: Number(val) }; break;\n    case \"TotalRejected\": out[7] = { payload: Number(val) }; break;\n    case \"ProductionRate\": out[8] = { payload: `${Number(val).toFixed(1)} units/min` }; break;\n    case \"ProductionTarget\": out[9] = { payload: Number(val) }; break;\n    case \"Feed_State\": out[10] = { payload: stateBadge(val) }; updFault(\"FeedingStation\", val); break;\n    case \"Feed_Received\": out[11] = { payload: Number(val) }; break;\n    case \"Feed_Speed\": out[12] = { payload: Number(val) }; break;\n    case \"Feed_Warn\": out[13] = { payload: warnBadge(val) }; break;\n    case \"Asm_State\": out[14] = { payload: stateBadge(val) }; updFault(\"AssemblyStation\", val); break;\n    case \"Asm_Processed\": out[15] = { payload: Number(val) }; break;\n    case \"Asm_CycleTime\": out[16] = { payload: Number(val) }; break;\n    case \"Asm_HousingCap\": out[17] = { payload: Number(val) }; break;\n    case \"Asm_HousingCnt\": out[18] = { payload: Number(val) }; break;\n    case \"Asm_Warn\": out[19] = { payload: warnBadge(val) }; break;\n    case \"Insp_State\": out[20] = { payload: stateBadge(val) }; updFault(\"InspectionStation\", val); break;\n    case \"Insp_Inspected\": out[21] = { payload: Number(val) }; break;\n    case \"Insp_Accepted\": out[22] = { payload: Number(val) }; break;\n    case \"Insp_Rejected\": out[23] = { payload: Number(val) }; break;\n    case \"Insp_CycleTime\": out[24] = { payload: Number(val) }; break;\n    case \"Insp_HousingCap\": out[25] = { payload: Number(val) }; break;\n    case \"Insp_HousingCnt\": out[26] = { payload: Number(val) }; break;\n    case \"Insp_Warn\": out[27] = { payload: warnBadge(val) }; break;\n}\nreturn out;",
    "outputs": 28,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1160,
    "y": 460,
    "wires": [
      ["ui_line_state"],
      ["ui_alarm_active"],
      ["ui_affected_station"],
      ["ui_fault_msg"],
      ["ui_warn_msg"],
