  {
    "id": "fn_write_var",
    "type": "function",
    "z": "tab_factory",
    "name": "Build Variable Write",
    "func": "const cfg = flow.get(\"opcua_cfg\");\nif (!cfg) return null;\nif (msg.topic === \"target\") {\n    const raw = (msg.payload && typeof msg.payload === \"object\") ? msg.payload.target : msg.payload;\n    const val = parseInt(raw, 10);\n    if (isNaN(val) || val < 1) return null;\n    return { topic: `${cfg.line.ProductionTarget};datatype=Int32`, datatype: \"Int32\", payload: val };\n}\nif (msg.topic === \"fault\") {\n    const val = parseInt(msg.payload, 10);\n    if (isNaN(val) || val < 0 || val > 3) return null;\n    return { topic: `${cfg.line.FaultInjection};datatype=Int32`, datatype: \"Int32\", payload: val };\n}\nif (msg.varKey && cfg.stations[msg.varKey]) {\n    const val = msg.datatype === \"Double\" ? parseFloat(msg.payload) : parseInt(msg.payload, 10);\n    if (isNaN(val)) return null;\n    return { topic: `${cfg.stations[msg.varKey]};datatype=${msg.datatype}`, datatype: msg.datatype, payload: val };\n}\nreturn null;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
