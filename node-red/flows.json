    {
        "id": "fn_write_var",
        "type": "function",
        "z": "tab_factory",
        "name": "Build Int32 Write",
        "func": "const cfg = flow.get(\"opcua_cfg\");\nif (!cfg) return null;\n\nif (msg.topic === \"target\") {\n    const raw = (msg.payload && typeof msg.payload === \"object\") ? msg.payload.target : msg.payload;\n    const val = parseInt(raw, 10);\n    if (isNaN(val) || val < 1) {\n        node.warn(\"Invalid ProductionTarget: \" + raw);\n        return null;\n    }\n    return {\n        topic: `${cfg.line.ProductionTarget};datatype=Int32`,\n        datatype: \"Int32\",\n        payload: val\n    };\n}\n\nif (msg.topic === \"fault\") {\n    const val = parseInt(msg.payload, 10);\n    if (isNaN(val) || val < 0 || val > 3) {\n        node.warn(\"Invalid FaultInjection: \" + msg.payload);\n        return null;\n    }\n    return {\n        topic: `${cfg.line.FaultInjection};datatype=Int32`,\n        datatype: \"Int32\",\n        payload: val\n    };\n}\n\nreturn null;",
        "outputs": 1,
        "noerr": 0,
