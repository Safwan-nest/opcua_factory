    {
        "id": "fn_conn_state",
        "type": "function",
        "z": "tab_factory",
        "name": "N17: Connection State Machine",
        "func": "const rawText = (msg.status && msg.status.text) ? String(msg.status.text).toLowerCase() : \"\";\nconst fill = (msg.status && msg.status.fill) ? String(msg.status.fill).toLowerCase() : \"\";\n\nconst prev = context.get(\"connState\") || \"INIT\";\nconst hadDisconnect = context.get(\"hadDisconnect\") || false;\n\nconst isUp = fill === \"green\" || rawText.includes(\"active\") || rawText.includes(\"subscribed\") || rawText.includes(\"keepalive\") || rawText.includes(\"session\");\nconst isDown = fill === \"red\" || rawText.includes(\"error\") || rawText.includes(\"closed\") || rawText.includes(\"disconnect\") || rawText.includes(\"reconnect\") || rawText.includes(\"terminated\") || rawText.includes(\"invalid\");\n\nlet nextState = prev;\nlet resubTrigger = null;\n\nif (isDown) {\n    nextState = \"DISCONNECTED\";\n    context.set(\"hadDisconnect\", true);\n    flow.set(\"opcua_connected\", false);\n} else if (isUp) {\n    if (hadDisconnect) {\n        nextState = \"RECONNECTED\";\n        context.set(\"hadDisconnect\", false);\n        resubTrigger = { payload: \"resubscribe\" };\n    } else if (prev === \"INIT\" || prev === \"DISCONNECTED\") {\n        nextState = \"CONNECTED\";\n    }\n    flow.set(\"opcua_connected\", true);\n}\n\nif (nextState === prev && !resubTrigger) return [null, null];\ncontext.set(\"connState\", nextState);\n\nconst colorMap = {\n    CONNECTED: \"#00c853\",\n    RECONNECTED: \"#29b6f6\",\n    DISCONNECTED: \"#ff5252\"\n};\nconst badge = `<span style=\"color:${colorMap[nextState] || '#aaa'};font-weight:bold;\">${nextState}</span>`;\nreturn [{ payload: badge }, resubTrigger];",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 510,
        "y": 660,
        "wires": [
            [
                "ui_conn_status"
            ],
            [
                "dly_resub"
            ]
        ]
    },
