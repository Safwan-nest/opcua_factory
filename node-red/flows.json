    {
        "id": "fn_config",
        "type": "function",
        "z": "tab_factory",
        "name": "1. EDIT NodeIDs HERE (Single Source of Truth)",
        "func": "const cfg = {\n    objects: {\n        ObjectsFolder: \"ns=0;i=85\",\n        Factory01: \"ns=1;i=1000\",\n        ProductionLine01: \"ns=1;i=1001\",\n        FeedingStation: \"ns=1;i=1002\",\n        AssemblyStation: \"ns=1;i=1003\",\n        InspectionStation: \"ns=1;i=1004\"\n    },\n    line: {\n        LineState: \"ns=1;i=2001\",\n        ProductionTarget: \"ns=1;i=2002\",\n        TotalProduced: \"ns=1;i=2003\",\n        TotalAccepted: \"ns=1;i=2004\",\n        TotalRejected: \"ns=1;i=2005\",\n        ProductionRate: \"ns=1;i=2006\",\n        AlarmActive: \"ns=1;i=2007\",\n        FaultMessage: \"ns=1;i=2008\",\n        FaultInjection: \"ns=1;i=2009\"\n    },\n    stations: {\n        Feed_State: \"ns=1;i=3001\",\n        Feed_Received: \"ns=1;i=3002\",\n        Feed_Speed: \"ns=1;i=3003\",\n        Asm_State: \"ns=1;i=3101\",\n        Asm_Processed: \"ns=1;i=3102\",\n        Asm_CycleTime: \"ns=1;i=3103\",\n        Insp_State: \"ns=1;i=3201\",\n        Insp_Inspected: \"ns=1;i=3202\",\n        Insp_Accepted: \"ns=1;i=3203\",\n        Insp_Rejected: \"ns=1;i=3204\"\n    },\n    methods: {\n        StartLine: \"ns=1;i=4001\",\n        StopLine: \"ns=1;i=4002\",\n        ResetFault: \"ns=1;i=4003\"\n    }\n};\n\nconst rev = {};\nfor (const [k, v] of Object.entries(cfg.line)) rev[v] = k;\nfor (const [k, v] of Object.entries(cfg.stations)) rev[v] = k;\n\nflow.set(\"opcua_cfg\", cfg);\nflow.set(\"opcua_rev\", rev);\nflow.set(\"station_states\", { FeedingStation: \"STOPPED\", AssemblyStation: \"STOPPED\", InspectionStation: \"STOPPED\" });\n\nnode.status({ fill: \"green\", shape: \"dot\", text: \"NodeID map loaded\" });\nreturn null;",
        "outputs": 0,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 60,
        "wires": []
