#include <open62541/server.h>
#include <open62541/server_config_default.h>
#include <signal.h>
#include <stdlib.h>

UA_Boolean running = true;

// Signal handler to stop the server gracefully when you press Ctrl+C
static void stopHandler(int sig) {
    UA_LOG_INFO(UA_Log_Stdout, UA_LOGCATEGORY_USERLAND, "Received stop signal");
    running = false;
}

int main(void) {
    // Capture Ctrl+C
    signal(SIGINT, stopHandler);
    signal(SIGTERM, stopHandler);

    // Initialize the server with default configurations
    UA_Server *server = UA_Server_new();
    UA_ServerConfig_setDefault(UA_Server_getConfig(server));

    UA_LOG_INFO(UA_Log_Stdout, UA_LOGCATEGORY_USERLAND, "Starting empty OPC UA Factory Server...");

    // Run the server in a loop until running = false
    UA_StatusCode retval = UA_Server_run(server, &running);

    // Clean up memory before shutting down
    UA_Server_delete(server);
    
    return retval == UA_STATUSCODE_GOOD ? EXIT_SUCCESS : EXIT_FAILURE;
}
